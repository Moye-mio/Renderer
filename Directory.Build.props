<?xml version="1.0" encoding="utf-8"?>
<!--
  仓库根 Directory.Build.props：MSBuild / VS 会自动导入。
  Tracy：Debug 默认开启；关闭用 /p:TitusTracyEnable=false 或改下方默认值。
  Release 默认关闭；开启用 /p:TitusTracyEnable=true。
  开启后的编译/链接选项与 Windows SDK 版本检查见 Directory.Build.targets。

  第三方库均在 Third-Party/（glm / gli / stb / Assimp / GLFW / GLEW 等）。
  GLM / OPENGL / ASSIMP / … 覆盖同名环境变量，一律为仓库内相对路径。

  工具集不写死版本：各 vcxproj 用 $(DefaultPlatformToolset)，跟随本机安装的 VS
  （VS2019→v142 / VS2022→v143 / 更新版本自动跟随），避免换机器报 MSB8020。
  需要锁定时用 msbuild /p:PlatformToolset=v142（命令行全局属性优先级更高）。
-->
<Project>
  <PropertyGroup>
    <TitusTracyRoot>$(MSBuildThisFileDirectory)Third-Party\tracy\public</TitusTracyRoot>
    <TitusTracyEnable Condition="'$(TitusTracyEnable)' == '' and '$(Configuration)' == 'Debug'">true</TitusTracyEnable>
    <TitusTracyEnable Condition="'$(TitusTracyEnable)' == ''">false</TitusTracyEnable>

    <!-- Vulkan SDK 体积过大，不随仓库分发。旧版安装器只写 VK_SDK_PATH，
         这里归一到 VULKAN_SDK，工程里统一引用它；缺失检查见 Directory.Build.targets。 -->
    <VULKAN_SDK Condition="'$(VULKAN_SDK)' == '' and '$(VK_SDK_PATH)' != ''">$(VK_SDK_PATH)</VULKAN_SDK>

    <GLM>$(MSBuildThisFileDirectory)Third-Party\glm</GLM>
    <GLI>$(MSBuildThisFileDirectory)Third-Party\gli</GLI>
    <STB_IMAGE>$(MSBuildThisFileDirectory)Third-Party\stb</STB_IMAGE>
    <ASSIMP>$(MSBuildThisFileDirectory)Third-Party\Assimp</ASSIMP>
    <OPENGL>$(MSBuildThisFileDirectory)Third-Party\OpenGL</OPENGL>
  </PropertyGroup>

  <!-- TracyClient.cpp 始终需要 public 头路径（无 TRACY_ENABLE 时几乎为空实现） -->
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(TitusTracyRoot);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
