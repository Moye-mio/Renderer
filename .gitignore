# === 编译输出 (中间文件与可执行文件) ===
*.o
*.obj
# 保留 Model/ 下的 Wavefront OBJ 模型（非编译产物）
!Model/**/*.obj
*.out
*.exe
*.app
*.so
*.a
*.lib
*.dll
*.dylib

# === 常见构建系统目录 ===
# CMake
/build/
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
install_manifest.txt
Makefile

# GNU Make
.deps/
.libs/

# === 常见 IDE & 编辑器配置 ===
# Visual Studio 构建输出目录（任意层级名为 x64/x86 的目录）
.vs/
*.user
*.userosscache
*.sln.docstates
*.suo
Debug/
Release/
x64/
x86/

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# CodeBuddy
.codebuddy/

# CLion / JetBrains
.idea/
cmake-build-*/

# Xcode
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
*.xcworkspace/

# === 操作系统与日志 ===
.DS_Store
Thumbs.db
*.log
*.tmp

# === 第三方预编译库 ===
# Assimp / GLFW / GLEW 的 .lib/.dll 以及 lib/x64、bin/x64 需覆盖上方忽略规则。
!Third-Party/Assimp/
!Third-Party/Assimp/**/
!Third-Party/Assimp/**/*.lib
!Third-Party/Assimp/**/*.dll
!Third-Party/OpenGL/
!Third-Party/OpenGL/**/
!Third-Party/OpenGL/**/*.lib
!Third-Party/OpenGL/**/*.dll
Tools/_dist/

# === 大型第三方场景（不入库，本地自行获取）===
Model/Bistro/

# === Renderer 运行时日志输出 ===
/Logs/

# === 各工程自动/手动截图输出（保留目录占位）===
**/results/*.png
!**/results/.gitkeep

# === RenderDoc ===
Rdcs/

# === 本地 Profiler（Tracy Viewer 等，不入库）===
/Profiler/
